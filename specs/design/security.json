{
  "version": 3,
  "permissions": [
    {
      "resource": "todo-items",
      "component": "todo-api",
      "description": "A user's own todo items",
      "actions": [
        { "handle": "read", "description": "The caller's own todo items" },
        { "handle": "write", "description": "Create, update and delete the caller's own todo items" }
      ]
    }
  ],
  "groups": [],
  "roles": [
    {
      "name": "User",
      "description": "Signs in and manages their own todo items.",
      "stories": [1, 2, 3, 4, 5, 6],
      "grants": ["todo-items:read", "todo-items:write"],
      "assignTo": ["Users"]
    }
  ],
  "testUsers": [
    { "username": "test-user", "roles": ["User"] }
  ]
}
